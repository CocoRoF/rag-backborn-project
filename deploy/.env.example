# ── RAG Backborn production env (copy to deploy/.env, chmod 600) ────────────────
# Public URL served by the Cloudflare tunnel.
RAGB_PUBLIC_URL=https://demo.example.com

# JWT/HKDF root secret: openssl rand -hex 32
# Rotating this logs everyone out.
RAGB_SECRET_KEY=

# Independent Fernet key for the encrypted API keys in the database.
#   docker compose -p ragb run --rm --no-deps backend python -m ragb.core.keytool generate
# Leaving it empty derives the key from RAGB_SECRET_KEY — fine on a fresh install, but then
# the two secrets can never be rotated independently. Pin the derived key with
# `keytool legacy` BEFORE changing RAGB_SECRET_KEY on an install that already stores secrets.
RAGB_ENCRYPTION_KEY=
RAGB_ENCRYPTION_KEY_PREVIOUS=

# Seeded administrator, created at boot when the address is free. Change the password from
# the console right after the first login.
RAGB_DEFAULT_ADMIN_ENABLED=true
RAGB_DEFAULT_ADMIN_EMAIL=admin@ragb.local
RAGB_DEFAULT_ADMIN_PASSWORD=admin123

# Postgres
POSTGRES_DB=ragb
POSTGRES_USER=ragb
POSTGRES_PASSWORD=

# SeaweedFS S3 gateway credential: openssl rand -hex 32
S3_ACCESS_KEY=ragb
S3_SECRET_KEY=

# Host port nginx binds on 127.0.0.1 (cloudflared ingress -> http://localhost:58800)
NGINX_PORT=58800
TZ=Asia/Seoul
RAGB_LOG_LEVEL=INFO
CLAUDE_CODE_VERSION=2.1.236
